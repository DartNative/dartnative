// Copy to Secrets.xcconfig (gitignored) and add your own key.
// Get a key from Google Maps Platform, enable "Maps SDK for iOS",
// and (if the key is app-restricted) allowlist this example's bundle id.
// Flow: MAPS_API_KEY -> Info.plist (GMSApiKey) -> AppDelegate.provideAPIKey().
MAPS_API_KEY = YOUR_IOS_MAPS_API_KEY
