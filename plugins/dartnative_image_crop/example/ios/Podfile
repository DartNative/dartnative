# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def dn_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'DartNative', 'Generated.xcconfig'),
    __FILE__
  )

  unless File.exist?(generated_xcode_build_settings_path)
    generated_xcode_build_settings_path = File.expand_path(
      File.join('..', 'DartNative', 'Generated.xcconfig'),
      __FILE__
    )
  end

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"dn pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/DN_ROOT\=(.*)/)
    return matches[1].strip if matches
 end
  raise "DN_ROOT not found in #{generated_xcode_build_settings_path}. Try dn pub get first."
end

require File.expand_path(File.join('bin', 'podhelper'), dn_root)

dartnative_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # dartnative_install_all_ios_pods auto-discovers the plugin via the
  # symlinks/plugins/dartnative_image_crop directory generated by
  # `dn pub get`, so a manual `pod 'dartnative_image_crop'` line
  # here would create a duplicate source and fail pod install with
  # "There are multiple dependencies with different sources".
  dartnative_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Pin FlexLayout to the same version as the framework playground.
  # FlexLayout 2.2.x added @MainActor annotations to its UIView extension
  # that dartnative_ios's DNCanvasView.swift does not satisfy under Swift 5.9
  # strict concurrency, so resolving against a newer FlexLayout breaks the
  # framework build. 2.0.10 is the last MainActor-free release.

  # The Xcode project (scaffolded from playground) carries a RunnerTests
  # target. Declare it here so CocoaPods doesn't warn about it on every
  # `pod install`. Empty inheritance — we have no actual test files.
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    dartnative_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      # Skip signing of the Pods. The Runner target itself is still
      # signed normally (or auto-signed for the simulator). Matches the
      # playground Podfile setup.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
