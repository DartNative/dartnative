# DartNative — repo-wide safety net.
# Each tutorial/app also has its own .gitignore; this catches anything
# generated or secret regardless of per-project coverage.

# OS / editor noise
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
*.iml

# Dart / Flutter build output
.dart_tool/
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.dn-plugins-dependencies

# iOS / CocoaPods
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
# The tool's engine placeholder podspec, rewritten by the podhelper on every pod install.
**/ios/DartNative/DartNativeCore.podspec
# Generated by the dn tool on every run/build with machine-local paths —
# never commit these.
**/ios/DartNative/Generated.xcconfig
**/ios/DartNative/dn_export_environment.sh
**/ios/DartNative/ephemeral/
**/Flutter/flutter_export_environment.sh
*.xcuserstate
**/xcuserdata/
DerivedData/
**/xcshareddata/IDEWorkspaceChecks.plist
**/xcshareddata/WorkspaceSettings.xcsettings

# Android / Gradle
.gradle/
**/.cxx/
local.properties

# Local-only dependency overrides (maintainers map to the private monorepo)
pubspec_overrides.yaml

# Secrets — never commit real keys. Templates end in .example and ARE tracked.
.env
.env.*
!.env.example
secrets.properties
Secrets.xcconfig
*.pem
*.p12
*.mobileprovision
.dnkeys

# Exported binaries
*.apk
*.aab
*.ipa
*.dSYM
*.dSYM.zip

# Lockfiles are regenerated by `dn pub get`.
pubspec.lock
dn_plugins.lock
